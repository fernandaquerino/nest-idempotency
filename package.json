{
  "name": "nest-idempotency",
  "version": "0.0.0",
  "description": "Idempotency-Key support for NestJS: make HTTP endpoints safe to retry, following the IETF Idempotency-Key HTTP header draft.",
  "keywords": [
    "nestjs",
    "nest",
    "idempotency",
    "idempotency-key",
    "idempotent",
    "retry",
    "redis",
    "interceptor"
  ],
  "license": "MIT",
  "author": "fernandaquerino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernandaquerino/nest-idempotency.git"
  },
  "bugs": {
    "url": "https://github.com/fernandaquerino/nest-idempotency/issues"
  },
  "homepage": "https://github.com/fernandaquerino/nest-idempotency#readme",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit test/contract/memory",
    "test:redis": "vitest run test/contract/redis test/e2e/redis",
    "test:e2e": "vitest run test/e2e",
    "test:dist": "npm run build && TEST_DIST=1 vitest run test/e2e",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "ioredis": "^5.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/testing": "^11.2.9",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "ioredis": "^5.11.1",
    "prettier": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.2.7"
  }
}
